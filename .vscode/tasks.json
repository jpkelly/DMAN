{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DSAN: syntax check",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "compileall", "-q", "dsan_capture", "tests"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "DSAN: infrastructure tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
